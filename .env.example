# Copy to .env for local development. Never commit real credentials.
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=8080
DATABASE_URL=postgresql://mark1:replace-with-local-dev-password@db:5432/mark1?schema=public
WEB_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=http://localhost:3000
E2E_WEB_URL=http://127.0.0.1:4173
E2E_API_URL=http://127.0.0.1:3000
E2E_PRODUCT_VERSION_ID=mark1-v1
E2E_AUTH_ENABLED=false
WXT_API_BASE_URL=http://localhost:3000
WXT_OAUTH_CLIENT_ID=
WXT_PRODUCT_VERSION_ID=mark1-v1
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
EMAIL_FROM=no-reply@example.test
SMTP_URL=smtp://localhost:1025
# Hashes external identities for account links. Required before any verifier is
# enabled; account linking stays disabled while it is empty. Generate with:
#   openssl rand -base64 32
LINK_SUBJECT_HMAC_SECRET=

# ==============================================================================
# MARK-1 MAIL — PHASE 1 CONFIGURATION
# ==============================================================================
# Authenticated AES-256-GCM encryption key for Gmail OAuth tokens at rest.
# Must be exactly 32 bytes (64 hex characters or 32 bytes base64).
# NEVER reuse SESSION_SECRET or LINK_SUBJECT_HMAC_SECRET for token encryption.
# Generate with: openssl rand -hex 32
MAIL_TOKEN_ENCRYPTION_KEY=replace-with-64-character-hex-key-from-openssl-rand-hex-32

# Google Cloud OAuth 2.0 Credentials (Web Application)
# Authorized redirect URI: http://localhost:5173/mail/callback (or your WEB_ORIGIN/mail/callback)
# Scopes: openid, userinfo.email, userinfo.profile, https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/mail/callback

# Razorpay (optional locally; required for checkout + payment entitlements).
# Set the key pair together or not at all — setting only one fails startup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required to mount the signed webhook route; without it entitlements are never granted.
RAZORPAY_WEBHOOK_SECRET=

# Public deployment (Cloudflare Tunnel -> web nginx -> API).
# WEB_ORIGIN must be the exact HTTPS origin with no path or trailing slash.
# Example: WEB_ORIGIN=https://nelctro.shop
WEB_ORIGIN=https://nelctro.shop
# Trust the single reverse-proxy hop so rate limiting sees the real client IP.
TRUST_PROXY=1
# Browser traffic is HTTPS at Cloudflare, so mark session cookies Secure.
SECURE_COOKIES=1
