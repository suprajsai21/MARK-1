# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mark1_dev
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
EMAIL_FROM=no-reply@example.test
SMTP_URL=smtp://localhost:1025
# Hashes external identities for account links. Required before any verifier is
# enabled; account linking stays disabled while it is empty. Generate with:
#   openssl rand -base64 32
LINK_SUBJECT_HMAC_SECRET=

# ==============================================================================
# MARK-1 MAIL — PHASE 1 CONFIGURATION
# ==============================================================================
# Authenticated AES-256-GCM encryption key for Gmail OAuth tokens at rest.
# Must be exactly 32 bytes (64 hex characters or 32 bytes base64).
# NEVER reuse SESSION_SECRET or LINK_SUBJECT_HMAC_SECRET for token encryption.
# Generate with: openssl rand -hex 32
MAIL_TOKEN_ENCRYPTION_KEY=replace-with-64-character-hex-key-from-openssl-rand-hex-32

# Google Cloud OAuth 2.0 Credentials (Web Application)
# Authorized redirect URI: http://localhost:5173/mail/callback (or your WEB_ORIGIN/mail/callback)
# Scopes: openid, userinfo.email, userinfo.profile, https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/mail/callback
