{
  "name": "@mark-1/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate --schema ../../packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../packages/db/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema ../../packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@mark-1/contracts": "workspace:*",
    "@mark-1/db": "workspace:*",
    "fastify": "5.6.2",
    "nodemailer": "7.0.10"
  },
  "devDependencies": {
    "@types/nodemailer": "6.4.21",
    "vitest": "3.2.4"
  }
}
