{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "manifest.ts", "wxt.config.ts", "vitest.config.ts", ".wxt/types/**/*.d.ts"]
}
