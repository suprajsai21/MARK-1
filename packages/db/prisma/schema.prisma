generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum PaymentOrderStatus {
  created
  paid
  failed
  refunded
  charged_back
}

enum EntitlementStatus {
  active
  revoked
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(254)
  passwordHash        String
  emailVerifiedAt     DateTime?
  role                UserRole                 @default(customer)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  linkChallenges      LinkChallenge[]
  accountLinks        AccountLink[]
  linkHistories       LinkHistory[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthTokenFamilies   OAuthTokenFamily[]
  paymentOrders        PaymentOrder[]
  purchases            Purchase[]
  entitlements         Entitlement[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LinkChallenge {
  id            String   @id @db.Uuid
  userId        String   @db.Uuid
  integrationId String   @db.VarChar(64)
  challengeHash String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountLink {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  integrationId       String   @db.VarChar(64)
  externalSubjectHash String   @db.VarChar(64)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, integrationId])
  @@unique([integrationId, externalSubjectHash])
  @@index([userId])
}

/** Retained after a link is removed so the relink cooldown survives the deletion. */
model LinkHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  integrationId       String   @db.VarChar(64)
  externalSubjectHash String   @db.VarChar(64)
  unlinkedAt           DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, integrationId, unlinkedAt])
  @@index([integrationId, externalSubjectHash, unlinkedAt])
  @@index([unlinkedAt])
}

model LinkAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String   @db.VarChar(32)
  targetId  String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

model OAuthAuthorizationCode {
  codeHash     String   @id @db.VarChar(64)
  userId       String   @db.Uuid
  clientId     String   @db.VarChar(256)
  redirectUri  String   @db.VarChar(2048)
  codeChallenge String  @db.VarChar(43)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model OAuthTokenFamily {
  id        String   @id @db.VarChar(32)
  userId    String   @db.Uuid
  clientId  String   @db.VarChar(256)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]

  @@index([userId, clientId])
  @@index([revokedAt])
}

model OAuthAccessToken {
  tokenHash String          @id @db.VarChar(64)
  familyId  String          @db.VarChar(32)
  expiresAt DateTime
  createdAt DateTime        @default(now())
  family    OAuthTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([expiresAt])
}

model OAuthRefreshToken {
  tokenHash String          @id @db.VarChar(64)
  familyId  String          @db.VarChar(32)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime        @default(now())
  family    OAuthTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([expiresAt])
}

model LinkPolicySetting {
  id                        Int      @id @default(1)
  relinkCooldownHours       Int      @default(168)
  requiresReverification    Boolean  @default(true)
  adminTransferApprovalRequired Boolean @default(true)
  updatedAt                 DateTime @default(now()) @updatedAt
  updatedById               String?  @db.Uuid
}

/**
 * Append-only admin-managed price history. A checkout order copies the
 * version's amount so a later price change cannot alter an existing order.
 */
model PriceVersion {
  id               String   @id @default(uuid()) @db.Uuid
  productVersionId String   @db.VarChar(64)
  amountPaise      BigInt
  currency         String   @db.VarChar(3)
  version          Int
  isCurrent        Boolean  @default(false)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now())
  orders           PaymentOrder[]

  @@unique([productVersionId, version])
  @@index([productVersionId, isCurrent])
}

model PaymentOrder {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  productVersionId String             @db.VarChar(64)
  amountPaise      BigInt
  currency         String             @db.VarChar(3)
  priceVersionId   String             @db.Uuid
  priceVersion     Int
  status           PaymentOrderStatus @default(created)
  razorpayOrderId  String             @unique @db.VarChar(64)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  price            PriceVersion       @relation(fields: [priceVersionId], references: [id])
  purchase         Purchase?

  @@index([userId])
  @@index([status])
}

/** Records a captured provider payment exactly once per provider payment ID. */
model Purchase {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @unique @db.Uuid
  userId            String      @db.Uuid
  productVersionId  String      @db.VarChar(64)
  amountPaise       BigInt
  currency          String      @db.VarChar(3)
  providerPaymentId String      @unique @db.VarChar(64)
  capturedAt        DateTime    @default(now())
  order             PaymentOrder @relation(fields: [orderId], references: [id])
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlement       Entitlement?
  refunds           Refund[]

  @@index([userId])
}

model Refund {
  id                 String   @id @default(uuid()) @db.Uuid
  purchaseId         String   @db.Uuid
  providerRefundId   String   @unique @db.VarChar(64)
  amountPaise        BigInt
  reason             String   @db.VarChar(32)
  createdAt          DateTime @default(now())
  purchase           Purchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
}

model Entitlement {
  id               String            @id @default(uuid()) @db.Uuid
  purchaseId       String            @unique @db.Uuid
  userId           String            @db.Uuid
  productVersionId String            @db.VarChar(64)
  status           EntitlementStatus @default(active)
  grantedAt        DateTime          @default(now())
  revokedAt        DateTime?
  revokeReason     String?           @db.VarChar(32)
  purchase         Purchase          @relation(fields: [purchaseId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/**
 * Verify-then-apply ledger: a provider event ID may only be processed once.
 * `payloadDigest` records what was applied without storing card data.
 */
model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  providerEventId String   @unique @db.VarChar(64)
  eventType       String   @db.VarChar(64)
  payloadDigest   String   @db.VarChar(64)
  receivedAt      DateTime @default(now())
  processedAt     DateTime?

  @@index([eventType])
  @@index([receivedAt])
}
